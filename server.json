{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.hybridforgelab/shipshape-mcp",
  "description": "Dockerfile and Kubernetes lint for AI agents: Pod Security Standards, A–F grade, a fix per finding.",
  "repository": {
    "url": "https://github.com/hybridforgelab/shipshape-mcp",
    "source": "github",
    "id": "1440329204"
  },
  "websiteUrl": "https://shipshape.hybridforgelab.com/integration.html#mcp-server",
  "version": "0.2.2",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "hybridforgelab-shipshape-mcp",
      "version": "0.2.2",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "RAPIDAPI_KEY",
          "description": "Your RapidAPI key",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "API_MARKET_KEY",
          "description": "Your api.market key, used when RAPIDAPI_KEY is not set",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "HFL_MARKETPLACE",
          "description": "rapidapi or apimarket, when both keys are set",
          "isRequired": false,
          "isSecret": false,
          "format": "string",
          "choices": [
            "rapidapi",
            "apimarket"
          ]
        }
      ]
    }
  ]
}
